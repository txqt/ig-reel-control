{
  "manifest_version": 3,
  "name": "Reel Video Control for Instagram",
  "version": "1.2.0",
  "description": "Pause/Resume, tốc độ phát, loop, chụp ảnh và thanh tua có preview cho Instagram Reels.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
